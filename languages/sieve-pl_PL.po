#. Plugin Name of the plugin
#: sieve.php
msgid "Sieve - Faceted Filter for WooCommerce"
msgstr "Sieve - Filtr fasetowy dla WooCommerce"

#. Plugin URI of the plugin
#: sieve.php
msgid "https://plogins.com/sieve/"
msgstr "https://plogins.com/sieve/"

#. Description of the plugin
#: sieve.php
msgid ""
"Fast, accessible faceted filtering for WooCommerce and WordPress. Beautiful "
"facet widgets, AJAX filtering with no page reload, a mobile filter drawer, "
"and Core Web Vitals by design."
msgstr ""
"Szybkie, dostępne filtrowanie fasetowe dla WooCommerce i WordPressa. "
"Eleganckie widżety faset, filtrowanie AJAX bez przeładowania strony, mobilny "
"panel filtrów oraz dbałość o Core Web Vitals."

